{
  "name": "liwi-monorepo",
  "version": "13.1.1",
  "private": true,
  "description": "db abstraction",
  "homepage": "https://github.com/christophehurpeau/liwi",
  "bugs": {
    "url": "https://github.com/christophehurpeau/liwi/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (http://christophe.hurpeau.com/)",
  "repository": "https://github.com/christophehurpeau/liwi.git",
  "workspaces": [
    "packages/*",
    "@todo-example/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsc -b",
    "clean": "rm -Rf docs dist test/node6 coverage",
    "clean:build": "pnpm -r --parallel run clean:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:eslint",
    "lint:eslint": "NODE_OPTIONS=--max_old_space_size=4096 eslint --quiet .",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC node --test --experimental-test-module-mocks '@(packages|@todo-example)/*/src/**/*.test.ts'",
    "test:coverage": "TZ=UTC node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" '@(packages|@todo-example)/*/src/**/*.test.ts'",
    "test:coverage:generate": "mkdir -p docs && TZ=UTC node --test --experimental-test-module-mocks --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=docs/coverage.lcov --test-coverage-include=\"src/**/*.ts\" '@(packages|@todo-example)/*/src/**/*.test.ts'",
    "test:watch": "TZ=UTC node --test '@(packages|@todo-example)/*/src/**/*.test.ts'",
    "tsc": "tsc -b",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "67.4.0",
    "@pob/eslint-config-typescript-react": "67.4.0",
    "@pob/rollup-esbuild": "10.0.0",
    "@pob/root": "27.5.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "browserslist": {
    "production": [
      "defaults",
      "> 0.2%",
      "not ie < 12",
      "not safari < 10",
      "not ios_saf < 10"
    ],
    "modern": [
      "defaults and >1% and supports es6-module"
    ]
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">= 11.0.0"
  }
}
